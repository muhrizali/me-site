---
import { getAllPostTags, getOurCollection, getOurCollectionItem } from '../../scripts/utils';
import { type Metadata } from '../../scripts/types';
import PostTagPage from '../../components/PostTagPage.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths () {
    let allTags = await getAllPostTags("BLOGS");
    return allTags.map((tag: string) => ({ params: { 'tag': tag } }));
}

const { tag } = Astro.params;

const metadata: Metadata = {
    title: `${tag} Tag`,
    description: `Collection of all blog posts containing the tag: ${tag}`
}
---

<Layout metadata={metadata}>
    <PostTagPage category={"BLOGS"} tag={tag} />
</Layout>

