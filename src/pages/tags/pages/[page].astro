---
// import type { GetStaticPaths } from "astro";
import type { GetStaticPaths } from "astro/dist";
import { getAllPostTags } from "../../../scripts/utils";
import * as _ from "lodash-es";


export const getStaticPaths = (
    async ({ paginate }) => {
        const allTags = await getAllPostTags();
        const allTagObjects = allTags.map((tag: string) => ({ 'tag': tag }));
        const tags = allTagObjects;
        return paginate(tags, { pageSize: 3 });
}) satisfies GetStaticPaths;

export const partial = true;

const { page } = Astro.props;
---

<h1>Page {page.currentPage} / {page.lastPage}</h1>
<ul>
  <!-- List the array of astronaut info -->
  {
    page.data.map(
        (item: any) => (
            <li>{item.tag}</li>
        )
    )
  }
</ul>
