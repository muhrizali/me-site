---
import Layout from "../../layouts/Layout.astro";
import TagSection from "../../components/TagSection.astro";
import { getAllPostTags } from "../../scripts/utils";
import { Metadata } from "../../scripts/types";


export async function getStaticPaths() {
    let allTags = await getAllPostTags();
    return allTags.map((tagValue: string) => ({ params: { tag: tagValue } }));
}

const { tag } = Astro.params;

const metadata: Metadata = {
    title: `${tag} Tag`,
    description: `Collection of all posts containing the tag: ${tag}`
}
---

<Layout metadata={metadata}>
    <TagSection tag={tag} />
</Layout>


