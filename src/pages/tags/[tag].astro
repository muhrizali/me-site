---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import { getAllPostTags } from "../../scripts/utils";
import * as _ from "lodash-es";


export async function getStaticPaths() {
    let allTags = await getAllPostTags();
    return allTags.map((tagValue: string) => ({ params: { tag: tagValue } }));
}

const { tag } = Astro.params;
---

<Layout>
    <h1 class="mt-6 mb-2 text-2xl/tight">
        <span class="tag-heading">{tag}</span>
    </h1>
    <PostList tag={tag} showMore={false} />
</Layout>


