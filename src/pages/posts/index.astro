---
import Layout from "../../layouts/Layout.astro";
import CategorySection from "../../components/CategorySection.astro";
import PostMap from "../../components/PostMap.astro";
import { getAllPostCategories } from "../../scripts/utils";

const categories = await getAllPostCategories();

const metadata = {
    title: "Posts",
    description: "Collection of all the blog posts, books, projects and notes I have worked on. Also contains all the categories and tags these of the posts."
}

---

<Layout metadata={metadata}>
    {
        categories?.map(
            (category: string) => (
                <CategorySection category={category} />
            )
        )
    }
    <PostMap />
</Layout>
