---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import PostMap from "../../components/PostMap.astro";
import { getAllPostCategories } from "../../scripts/utils";

const categories = await getAllPostCategories();
---

<Layout title="Posts">
    {
        categories?.map(
            (category: string) => (
                <h2 class="mt-6 mb-2 text-2xl/tight tracking-tight text-heading font-bold">{category}</h2>
                <PostList category={category} count={3} />
            )
        )
    }

