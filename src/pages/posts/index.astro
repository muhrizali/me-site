---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
---

<Layout>

<h2 class="mb-4 text-2xl/tight text-heading font-bold">BLOGS</h2>
<PostList target="blogPosts" count={3} showMore={true} />

<h2 class="mb-4 text-2xl/tight text-heading font-bold">BOOKS</h2>
<PostList target="bookPosts" count={3} showMore={true} />

<h2 class="mb-4 text-2xl/tight text-heading font-bold">NOTES</h2>
<PostList target="notePosts" count={3} showMore={true} />

<h2 class="mb-4 text-2xl/tight text-heading font-bold">PROJECTS</h2>
<PostList target="projectPosts" count={3} showMore={true} />

</Layout>
