---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import PostMap from "../../components/PostMap.astro";
---

<Layout title="Posts">

<h2 class="mt-6 mb-2 text-2xl/tight tracking-tight text-heading font-bold">BLOGS</h2>
<PostList category={"BLOGS"} count={3} />

<h2 class="mt-6 mb-2 text-2xl/tight tracking-tight text-heading font-bold">BOOKS</h2>
<PostList category={"BOOKS"} count={3} />

<h2 class="mt-6 mb-2 text-2xl/tight tracking-tight text-heading font-bold">NOTES</h2>
<PostList category={"NOTES"} count={3} />

<h2 class="mt-6 mb-2 text-2xl/tight tracking-tight text-heading font-bold">PROJECTS</h2>
<PostList category={"PROJECTS"} count={3} />

<PostMap />
</Layout>
