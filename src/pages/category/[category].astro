---
import Layout from "../../layouts/Layout.astro";
import PostSectionCategory from "../../components/PostSectionCategory.astro";
import { getAllPostCategories } from "../../scripts/utils";
import { Metadata } from "../../scripts/types";


export async function getStaticPaths() {
    let allTags = await getAllPostCategories();
    return allTags.map((catValue: string) => ({ params: { category: catValue } }));
}

const { category } = Astro.params;

const metadata: Metadata = {
    title: `${category} Category`,
    description: `Collection of all posts belonging to category: ${category}`
}

---
<Layout metadata={metadata}>
    <PostSectionCategory category={category} loadMore={true} />
</Layout>


