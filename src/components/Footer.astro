---
import { Image } from "astro:assets";
import myGlassesImage from "../assets/my-glasses-image.jpg";
---

<footer class="border-t-2 border-default">
    <div class="max-w-3xl mx-auto">
        <aside class="py-4 px-4">
            <figure class="flex flex-row gap-4">
                <div
                    class="h-30 w-30 min-h-30 min-w-30 border-2 border-default mx-auto">
                    <Image
                        src={myGlassesImage}
                        width={400}
                        height={400}
                        alt="Photo of me holding oddly colored glasses to look into your eyes straight"
                        class="w-full h-full"
                    />
                </div>
                <div>
                    <figcaption
                        class="typography-common font-mono text-xs/tight sm:text-sm/tight text-body-subtle">
                        This guy thinks its funny to put a goofy photo of him
                        on his website from the day he was feeling particularly photogenic.
                        <br />
                    </figcaption>
                    <ul
                        class="border-0 mt-4 font-medium font-mono text-body-subtle list-none list-outside text-sm/snug tracking-tight flex flex-row gap-4">
                        <!-- <li class="">
                            <a
                                href="#"
                                class="decoration-1 decoration-brand underline hover:decoration-2 active:decoration-2">
                                RSS
                            </a>
                        </li>
                        <li class="">
                            <a
                                href="#"
                                class="decoration-1 decoration-brand underline hover:decoration-2 active:decoration-2">
                                SiteMap
                            </a>
                        </li> -->
                    </ul>
                </div>
            </figure>
        </aside>

        <div class="p-6">
            <p class="block text-xs text-body text-center">
                &copy; 2026 <a
                    href="https://raw.githubusercontent.com/muhrizali/me-site/refs/heads/master/LICENSE"
                    class="underline">Muhriz Ali</a
                > | Made With ❤️ & <a
                    href="https://astro.build/"
                    class="underline decoration-1">Astro</a
                >
            </p>
        </div>
    </div>
</footer>
