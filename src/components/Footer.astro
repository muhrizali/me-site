---
import { Image } from "astro:assets";
import myGlassesImage from "../assets/my-glasses-image.jpg";
import RightSidebar from "../components/RightSidebar.astro";

const footerLinks = [
    {
        label: "Status",
        link: "/status",
    },
    {
        label: "Archive",
        link: "/archive",
    },
];
---

<footer class="border-t-2 border-default-edge bg-surface-soft">
    <div class="max-w-3xl mx-auto">
        <aside class="py-4 px-4">
            <figure class="flex flex-row gap-4">
                <div
                    class="h-24 w-24 min-h-24 min-w-24 border-2 border-default-edge mx-auto">
                    <Image
                        src={myGlassesImage}
                        width={400}
                        height={400}
                        alt="Photo of me holding oddly colored glasses to look into your eyes straight"
                        class="w-full h-full"
                    />
                </div>
                <div>
                    <figcaption
                        class="typography-common font-sans text-xs sm:text-sm text-body-muted">
                        This guy thinks its funny to put a goofy photo of him on
                        his website from the day he was feeling particularly
                        photogenic.
                        <br />
                    </figcaption>
                    <ul
                        class="border-0 mt-4 font-medium font-mono text-body list-none list-outside text-xs/snug tracking-tight flex flex-row gap-4 uppercase">
                        {
                            footerLinks.map((item: any) => (
                                <li class="">
                                    <a
                                        href={item.link}
                                        class="decoration-1 decoration-primary hover:underline active:underline">
                                        {item.label}
                                    </a>
                                </li>
                            ))
                        }
                        <!-- <li>
                            <button
                                class="cursor-pointer decoration-1 decoration-primary hover:underline active:underline">
                                OPTIONS
                            </button>
                        </li> -->
                    </ul>
                </div>
            </figure>
        </aside>

        <!-- SIDEBAR OPTIONS -->
        <!-- <RightSidebar /> -->


        <div
            class="p-6 font-mono text-xs/tight tracking-tight text-body text-center">
            <p>
                &copy; 2026 <a
                    href="https://raw.githubusercontent.com/muhrizali/me-site/refs/heads/master/LICENSE"
                    class="underline">Muhriz Ali</a
                > | Made With ❤️ & <a
                    href="https://astro.build/"
                    class="underline decoration-1">Astro</a
                >
            </p>
        </div>
    </div>
</footer>
