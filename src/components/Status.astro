---
import { DateTime } from "luxon";

interface Props {
    date: string;
}

const { date } = Astro.props;
const statusDate = DateTime.fromISO(date).toFormat("yyyy LLL dd");
---

<section class="border-b-2 border-default-edge">
    <h4 class="text-body-muted! text-left">{statusDate}</h4>
    <slot />
</section>