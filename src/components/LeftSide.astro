---
import { Image } from "astro:assets";
import myGlassesImage from "../assets/me.jpg";
import Writing from "./Writing.astro";
---

<div class="">
    <figure class="flex flex-row gap-4 sm:flex-col w-fit">
        <figcaption class="text-xs/tight text-body-subtle ">
            This guy thinks its funny to put a goofy photo of him from the day he was feeling particularly photogenic on his website
        </figcaption>
        <Image
            src={myGlassesImage}
            width="400"
            height="400"
            alt="Photo of me holding oddly colored glasses to look into your eyes straight"
            class="h-40 md:h-50 w-40 md:w-50 border-2 border-default sm:mr-auto"
        />
    </figure>





</div>
