---
import { Image } from "astro:assets";
import myBaseImage from "../assets/my-base-image.jpg";
import myGlassesImage from "../assets/my-glasses-image.jpg";
---

<div class="">
    <figure class="flex flex-row gap-4 sm:flex-col w-fit">
        <div
            class="h-30 min-h-30 sm:h-40 w-30 min-w-30 sm:w-40 border-2 border-default sm:mx-auto relative">
            <Image
                src={myGlassesImage}
                width={400}
                height={400}
                alt="Photo of me holding oddly colored glasses to look into your eyes straight"
                class="absolute w-full h-full z-0 top-0 left-0"
            />
            <Image
                src={myBaseImage}
                width={400}
                height={400}
                alt="Photo of me holding oddly colored glasses to look into your eyes straight"
                class="absolute w-full h-full z-10 top-0 left-0 hover:opacity-0 active:opacity-0 transition-opacity"
            />
        </div>
        <figcaption class="typography-common text-xs/tight sm:text-sm/tight text-body-subtle sm:ml-4">
            This guy thinks its funny to put a goofy photo of him from the day he was feeling particularly photogenic.
            <br />
        </figcaption>
    </figure>
</div>
