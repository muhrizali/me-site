---
import { DateTime } from "luxon";
import PostTimeInfo from "./PostTimeInfo.astro";
import TOCList from "./TOCList.astro";

// headings structure
// {depth: (number), text: (string), slug: (string slug)}

const { frontmatter, headings } = Astro.props;

---

<div class="w-full my-4">
    <h1 class="my-2 tracking-tight font-bold text-heading text-3xl/tight">{frontmatter.title}</h1>
    <PostTimeInfo frontmatter={frontmatter} />


    <!-- Description -->
    <div class="py-4 typography-common text-body-subtle text-lg/tight">
        <p><span class="text-brand font-bold font-mono">//</span> {frontmatter.description}</p>
    </div>

    <!-- Table Of Contents -->
    {
        headings.length > 0
            ? (<TOCList headings={headings}/>)
            : ""
    }
</div>
