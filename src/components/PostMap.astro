---
import { getAllPostCategories,  getAllPostTags } from "../scripts/utils";

let categories = await getAllPostCategories();
let tags = await getAllPostTags();

---
<div class="mt-20">
    <table class="w-full text-left rtl:text-right">
        <tbody>
            <tr class="border-y-2 border-default">
                <th scope="row" class="hidden sm:table-cell p-2 font-bold text-body-subtle whitespace-nowrap">
                    TYPES
                </th>
                <td class="p-2 flex flex-row flex-wrap">
                    {
                        categories.map(
                            (category: string) => (
                                <a href="#" class="typography-common text-sm inline-block font-medium text-brand decoration-2 hover:underline active:underline my-0.5 mx-1">{category}</a>
                            )
                        )
                    }
                </td>
            </tr>
            <tr class="border-b-2 border-default">
                <th scope="row" class="hidden sm:table-cell p-2 font-bold text-body-subtle whitespace-nowrap">
                    TAGS
                </th>
                <td class="p-2 flex flex-row flex-wrap text-sm">
                    {
                        tags.map(
                            (tag: string) => (
                                <a href="#" class="inline-block tag-link m-0.5">{tag}</a>
                            )
                        )
                    }
                </td>
            </tr>
        </tbody>
    </table>
</div>

