---
import { getAllPostCategories,  getAllPostTags } from "../scripts/utils";

interface Props {
    scope?: "website" | "post";
    frontmatter?: any;
}

const { scope = "website", frontmatter = null } = Astro.props;

let categories = [];
let tags = [];

if (scope === "website") {
    categories = await getAllPostCategories();
    tags = await getAllPostTags();
} else if (scope === "post") {
    categories = [frontmatter?.category];
    tags = frontmatter?.tags;
}


---
<div class="mt-10">
    <table class="w-full text-left rtl:text-right">
        <tbody>
            <tr class="border-y-2 border-default">
                <th class="hidden w-20 max-w-20 text-left sm:table-cell p-2 font-bold text-body-subtle whitespace-nowrap">
                    TYPE
                </th>
                <td class="p-2 flex flex-row flex-wrap">
                    {
                        categories.map(
                            (category: string) => (
                                <a href={`/category/${category}`} class="typography-common text-sm inline-block font-medium text-brand decoration-2 hover:underline active:underline my-0.5 mx-1">{category}</a>
                            )
                        )
                    }
                </td>
            </tr>
            <tr class="border-b-2 border-default">
                <th scope="row" class="hidden w-20 max-w-20 text-left sm:table-cell p-2 font-bold text-body-subtle whitespace-nowrap">
                    TAGS
                </th>
                <td class="p-2 flex flex-row flex-wrap text-sm">
                    {
                        tags.map(
                            (tag: string) => (
                                <a href={`/tags/${tag}`} class="inline-block tag-link m-0.5">{tag}</a>
                            )
                        )
                    }
                </td>
            </tr>
        </tbody>
    </table>
</div>

