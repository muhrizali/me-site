---
import Image from "astro/components/Image.astro";
import theDesperateMan from "../assets/the-desperate-man.jpg";


---
<figure class="px-0 mb-5">
    <Image
        src={theDesperateMan} 
        alt="[1843 Painting by Gustave Courbet]: A desperate man is watching you intently"
        class="mx-auto w-full border-2 border-default"
        height={561}
        width={1500}
    />
    <figcaption 
        class="mt-2 font-mono text-body-subtle text-xs/tight tracking-tight hyphens-auto">
                [&uarr;] me when I see surf through this site / "I wrote that?"
    </figcaption>
</figure>