---
import PostTimelineList from "./PostTimelineList.astro";
interface Props {
    category: string;
}

const { category } = Astro.props;
---
<section class="mt-6">
    <h3 class="text-xl/tight tracking-tight text-heading font-bold">
        <a href={`/category/${category}`} class="decoration-2 decoration-brand hover:underline active:underline font-mono">{category}</a>
    </h3>
    <PostTimelineList category={category} />
</section>