---
import { DateTime } from 'luxon';


interface Props {
    postItem: any;
}

const { postItem } = Astro.props;
let postLink: string = "/";

switch (postItem.collection) {
    case "blogPosts":
        postLink = `/blogs/${postItem.id}`;
        break;
    case "notePosts":
        postLink = `/notes/${postItem.id}`;
        break;
    case "bookPosts":
        postLink = `/books/${postItem.id}`;
        break;
    case "projectPosts":
        postLink = `/projects/${postItem.id}`;
        break;
}

const postDatePublished = DateTime.fromISO(postItem.data.datePublished).toLocaleString(DateTime.DATETIME_MED);


---

<li class="border-2 border-transparent hover:border-default active:border-default px-4 pb-4">
    <a href={postLink}>
        <h3 class="text-xl/tight font-bold text-heading">
            {postItem.data.title}
        </h3>
        <p class="mb-2 text-body-subtle text-sm font-sans">
            {postDatePublished}

        </p>
        <small class="text-body text-sm/snug tracking-tight line-clamp-3">
            {postItem.data.description}
        </small>
    </a>
</li>
