---
import { DateTime } from 'luxon';


interface Props {
    postItem: any;
}

const { postItem } = Astro.props;
let postLink: string = "/";

switch (postItem.collection) {
    case "blogPosts":
        postLink = `/blogs/${postItem.id}`;
        break;
    case "notePosts":
        postLink = `/notes/${postItem.id}`;
        break;
    case "bookPosts":
        postLink = `/books/${postItem.id}`;
        break;
    case "projectPosts":
        postLink = `/projects/${postItem.id}`;
        break;
}

const postDatePublished = DateTime.fromISO(postItem.data.datePublished).toLocaleString(DateTime.DATETIME_MED);


---

<li class="border-2 border-transparent hover:border-default active:border-default p-3">
    <a href={postLink}>
        <h3 class="typography-common text-lg/tight font-semibold text-heading">
            {postItem.data.title}
        </h3>
        <p class="typography-common mb-2 text-body-subtle text-base font-normal">
            {postDatePublished}

        </p>
        <p class="typography-common text-body text-sm/tight line-clamp-2">
            {postItem.data.description}
        </p>
    </a>
</li>
