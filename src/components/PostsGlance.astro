---
import PostsGlanceList from "./PostsGlanceList.astro";
import { getAllPostCategories } from "../scripts/utils";

const allCategories = await getAllPostCategories();

---
<div class="grid md:grid-cols-2 gap-2">
    {
        allCategories.map(
            (category: string) => (
                <section class="p-2">
                    <h3 class="text-xl/tight tracking-tight text-body-strong font-bold font-mono">
                        <a href={`/category/${category}`} class="decoration-2 decoration-primary hover:underline active:underline">{category}</a>
                    </h3>
                    <PostsGlanceList category={category} count={3} />
                </section>
            )
        )
    }
</div>