---
interface Props {
    headings: {depth: number, text: string, slug: string}[]
}
const { headings } = Astro.props;

---
<div class="mb-6 text-sm/tight tracking-tight border-2 border-default-edge bg-surface font-mono">
    <details class="text-body-muted">
        <summary class="py-2 px-4 cursor-pointer marker:text-primary">
            CONTENTS
        </summary>
        <ul class="mx-2 mb-2 text-sm/tight">
            {
                headings.map(
                    (heading: any) => (
                        <li style={`margin-left: ${0.5 * ((heading.depth >= 2) ? (heading.depth-1) : 0)}rem`} class="pl-1 py-0.5 border-l-2 border-l-transparent hover:border-primary active:border-primary">
                            <a href={`#${heading.slug}`} class="block w-full h-full text-body hover:text-primary active:text-primary">{heading.text}</a>
                        </li>
                    )
                )
            }
        </ul>
    </details>
</div>
