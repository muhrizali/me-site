---
import { DateTime } from 'luxon';
import type { CollectionEntry } from 'astro:content';


interface Props {
    postEntry: CollectionEntry<'posts'>;
}

const { postEntry } = Astro.props;

const postDatePublished = DateTime.fromISO(postEntry.data.datePublished).toLocaleString(DateTime.DATETIME_MED);


---

<li class="group p-2">
    <a 
        href={`/posts/${postEntry.id}`}>
        <div>
            <h3 
                class="typography-common text-lg/tight font-bold group-active:text-brand group-hover:text-brand text-heading">
                {postEntry.data.title}
            </h3>    
            <p 
                class="typography-common text-body-subtle group-active:text-body group-hover:text-body text-sm/tight line-clamp-3">
                {postEntry.data.description}
            </p>
        </div>
    </a>
</li>
