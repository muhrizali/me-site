---
import { DateTime } from 'luxon';
import type { CollectionEntry } from 'astro:content';


interface Props {
    postEntry: CollectionEntry<'posts'>;
}

const { postEntry } = Astro.props;

const postDatePublished = DateTime.fromISO(postEntry.data.datePublished).toLocaleString(DateTime.DATETIME_MED);


---

<li class="border-2 border-transparent hover:border-default active:border-default p-3">
    <a href={`/posts/${postEntry.id}`}>
        <h3 class="typography-common text-lg/tight font-semibold text-heading">
            {postEntry.data.title}
        </h3>
        <p class="typography-common mb-2 text-body-subtle text-base font-normal">
            {postDatePublished}

        </p>
        <p class="typography-common text-body text-sm/tight line-clamp-2">
            {postEntry.data.description}
        </p>
    </a>
</li>
