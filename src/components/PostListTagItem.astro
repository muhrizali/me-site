---
import { DateTime } from 'luxon';
import PostListItemSection from './PostListItemSection.astro';


interface Props {
    postEntry: any;
}

const { postEntry } = Astro.props;


---

<li class="group">
    <a 
        href={`/posts/${postEntry.id}`} 
        class="flex flex-row gap-2">
        <PostListItemSection postEntry={postEntry} />
    </a>
</li>
