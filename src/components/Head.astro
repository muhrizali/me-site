---
import { Font } from "astro:assets";
import { Metadata } from "../scripts/types";

interface Props {
    metadata: Metadata;
}

const { metadata } = Astro.props;

---
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{metadata.title}</title>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="robots" content="index,find" />
<meta name="googlebot" content="index,find" />
<meta name="description" content={metadata.description} />

<!-- HTMX Config -->
<meta name="htmx-config" content='preload:{"autoBoost":false}'>


<!-- HTMX Scripts -->
<script>
    import 'htmx.org';
    import 'htmx.org/dist/ext/hx-preload';
</script>

<!-- Astro Fonts Config -->
<!-- <Font cssVariable="--font-alias-serif" /> -->
<Font cssVariable="--font-alias-sans" />
<Font cssVariable="--font-alias-mono" />
