---
import Image from "astro/components/Image.astro";
import * as _ from "lodash-es";


interface LearnMoreLinks {
    goodreads: string;
    amazon: string;
}

interface Props {
    imgref: string;
    authors: string[];
    links: LearnMoreLinks;
}

let { imgref, authors, links } = Astro.props;

authors = _.join(authors, " | ");

---

<aside 
    class="border-2 border-default bg-neutral-primary-strong p-4 flex flex-col sm:flex-row gap-4 mb-5">
        <Image 
        src={imgref} 
        alt="Cover for: Harry Potter And The Sorcerer's Stone" 
        height={400}
        width={600}
        class="mx-auto border-2 border-default h-48 w-36"
        />
        <section class="w-full p-0">
            <div class="line-clamp-3 text-body">
                <slot />
            </div>
            <div class="text-body">
                <span class="text-body-subtle italic font-mono">written by</span>
                <p>{authors}</p>
            </div>
            <div class="text-right">
                <span class="text-body-subtle italic text-right font-mono">learn more</span>
                <p>
                    <a href={links.goodreads}>Goodreads</a> | <a href={links.amazon}>Amazon</a>
                </p>
            </div>
        </section>
</aside>