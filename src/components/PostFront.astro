---
import { DateTime } from "luxon";
import TOCList from "./TOCList.astro";
import PostFrontBlog from "./PostFrontBlog.astro";
import PostFrontBook from "./PostFrontBook.astro";
import PostFrontProject from "./PostFrontProject.astro";
import PostFrontNote from "./PostFrontNote.astro";

// headings structure
// {depth: (number), text: (string), slug: (string slug)}

const { frontmatter, headings } = Astro.props;
const datePublished = DateTime.fromISO(frontmatter.datePublished).toFormat("LLL dd yyyy");
const dateModified = DateTime.fromISO(frontmatter.dateModified).toFormat("LLL dd yyyy");
---

<section class="w-full">
    <h1
        class="mb-4 text-3xl/tight tracking-normal text-pretty text-body-strong font-bold">
        {frontmatter.title}
    </h1>

    { (frontmatter.category === "BLOGS") && (<PostFrontBlog frontmatter={frontmatter} />) }
    { (frontmatter.category === "BOOKS") && (<PostFrontBook frontmatter={frontmatter} />) }
    { (frontmatter.category === "PROJECTS") && (<PostFrontProject frontmatter={frontmatter} />) }
    { (frontmatter.category === "NOTES") && (<PostFrontNote frontmatter={frontmatter} />) }


    <div
        class="pb-4 mb-6 font-mono text-body-muted typography-common text-sm/tight flex flex-col sm:flex-row gap-4 sm:gap-8 border-b-2 border-default-edge">
        <div>
            <p>DATE</p>
            <p class="text-body">
                <time datetime={frontmatter.datePublished} class="">{datePublished}</time>
                <br />
                <time datetime={frontmatter.datePublished} class="">Last Updated: {dateModified}</time>
            </p>
        </div>
        <div>
            <p>ME?</p>
            <p class="text-body">Muhriz Ali</p>
        </div>
    </div>

    <!-- Table Of Contents -->
    {headings.length > 0 && <TOCList headings={headings} />}
    <!-- <hr class="mb-6 border-t-2 border-primary/60" /> -->
</section>
