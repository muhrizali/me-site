---
import { getCollection } from "astro:content";
import * as _ from "lodash-es";


interface Props {
    target: string;
    count?: number;
}


async function getOurCollection(key: string, count: number) {

    let collection = [];

    // Getting the list of posts from target
    if (key === "all") {
        collection = [
            ...(await getCollection("blogPosts")),
            ...(await getCollection("notePosts")),
            ...(await getCollection("bookPosts")),
            ...(await getCollection("projectPosts")),
        ];
    } else {
        collection = await getCollection(key);
    }
    
    // Filtering and organizing the returned posts
    collection = _.reverse(_.sortBy(collection, ["data.datePublished"]));
    collection = _.filter(collection, (item: any) => !item.data["isDraft"]);

    if (count === 0) {
      return collection
    } else if (collection.length < count) {
      return collection.slice(0, collection.length);
    } else {
      return collection.slice(0, count);
    }
}

let { target = "all", count = 0 } = Astro.props;

let collection = await getOurCollection(target, count);
let sectionLink: string = "/";

switch(target) {
    case "blogPosts":
        sectionLink = "/blogs/";
        break;
    case "notePosts":
        sectionLink = "/notes/";
        break;
    case "projectPosts":
        sectionLink = "/projects/";
        break;
    case "bookPosts":
        sectionLink = "/books/";
        break;
}

---
<div class="">
    <ul class="ml-4 text-body list-disc list-outside text-base/snug tracking-tight">
        {
            collection.map(
                (item) => (
                    <li class="mb-0">
                        <a class="text-brand no-underline decoration-2 hover:underline active:underline line-clamp-1" href={sectionLink + item.id}>{item.data.title}</a>
                    </li>
                )
            )
        }
</ul>
</div>