---
import { getOurCollection } from "../scripts/utils";
import * as _ from "lodash-es";

interface Props {
    category: string | null;
    count: number;
}


let { category = null, count = 0 } = Astro.props;

let collection = await getOurCollection({category, count, tag: null, sortby: null});

---
<ul class="ml-4 text-body list-disc list-outside text-base/snug tracking-tight">
    {
        collection.map(
            (item) => (
                <li class="mb-0">
                    <a class="text-brand no-underline decoration-2 hover:underline active:underline line-clamp-1" href={`/posts/${item.id}`}>{item.data.title}</a>
                </li>
            )
        )
    }
</ul>