---
import PostLink from "./PostLink.astro";
// import { getCollection } from "astro:content";
import * as _ from "lodash-es";
import { getOurCollection } from "../scripts/utils";
import type { CollectionEntry } from "astro:content";



interface Props {
    category?: string;
    tag?: string;
    count?: number;
    showMore: boolean;
}


let { category = null, tag = null, count = null, sortby = null, showMore = false } = Astro.props;

let collection = await getOurCollection({category, tag, count, sortby});
// let morePostsLink = { href: "/", label: "Generic" };

---
<div class="mb-8">
    <ul class="space-y-2">
        {
            collection.map(
                (item) => (
                    <PostLink postEntry={item} />
                )
            )
        }
</ul>
