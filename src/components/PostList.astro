---
import PostListItem from "./PostListItem.astro";
import PostTagListItem from "./PostTagListItem.astro";
import LoadButton from "./LoadButton.astro";
import * as _ from "lodash-es";
import { getOurCollection, CONFIG } from "../scripts/utils";

interface Props {
    category?: string;
    tag?: string;
    count?: number;
    loadMore?: boolean;
}


let { category = null, tag = null, count = CONFIG.sectionItemsCount, sortby = null, loadMore = false } = Astro.props;

let route = "";
if (category) {
    route = category;
} if (tag) {
    route = tag;
}

let collection = await getOurCollection({category, tag, count, sortby});
let totalItems = (await getOurCollection({category, tag})).length;

if (totalItems <= count) {
    loadMore = false;
}

---
<ul class="space-y-4">
    {
        (tag)
            ? (
                collection.map(
                    (item) => (
                        <PostTagListItem postEntry={item} />
                    )
                )
            )
            : (
                collection.map(
                    (item) => (
                        <PostListItem postEntry={item} />
                    )
                )
            )
    }
    {
        loadMore
            ? (
              category 
              ? <LoadButton routeURL={`/htmx/category/${route}/2`} />
              : <LoadButton routeURL={`/htmx/tag/${route}/2`} />
            )
            : ( "" )
    }
</ul>
