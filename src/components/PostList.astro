---
import PostListItem from "./PostListItem.astro";
import PostListTagItem from "./PostListTagItem.astro";
import LoadButton from "./LoadButton.astro";
import * as _ from "lodash-es";
import { getOurCollection, CONFIG, type ContentCollection } from "../scripts/utils";


interface Props {
    category: ContentCollection;
    tag?: string;
    count?: number;
    loadMore?: boolean;
}


let { category, tag = null, count = CONFIG.sectionItemsCount, sortby = null, loadMore = false } = Astro.props;

let route: string;
if ((category === "POSTS") && tag) {
    route = tag;
} else {
    route = CONFIG.routeTable[category];
}


let collection = await getOurCollection({category, tag, count, sortby});
let totalItems = (await getOurCollection({category, tag})).length;

if (totalItems <= count) {
    loadMore = false;
}

---
<ul class="space-y-4">
    {
        (tag)
            ? (
                collection.map(
                    (item) => (
                        <PostListTagItem postEntry={item} />
                    )
                )
            )
            : (
                collection.map(
                    (item) => (
                        <PostListItem postEntry={item} />
                    )
                )
            )
    }
    {
        loadMore
            && (
                (tag) 
                    ? <LoadButton routeURL={`/${route}/partial/${tag}/2`} />
                    : <LoadButton routeURL={`/${route}/partial/2`} />
            )
    }
</ul>
