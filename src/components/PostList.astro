---
import PostLink from "./PostLink.astro";
// import { getCollection } from "astro:content";
import * as _ from "lodash-es";
import { getOurCollection } from "../scripts/utils";



interface Props {
    category?: string;
    tag?: string;
    count?: number;
}


let { category = null, tag = null, count = null, sortby = null } = Astro.props;

let collection = await getOurCollection({category, tag, count, sortby});

---
<ul class="space-y-2">
    {
        collection.map(
            (item) => (
                <PostLink postEntry={item} />
            )
        )
    }
</ul>
