---
import { DateTime } from "luxon";
import * as _ from "lodash-es";
import Image from "astro/components/Image.astro";


interface Props {
    frontmatter: any;
}

const { frontmatter } = Astro.props;
const datePublished = DateTime.fromISO(frontmatter.bookPublished).toFormat("LLL dd yyyy");

const authorsString = _.join(frontmatter.authors, " / ")
---

<div class="py-0">
    <figure class="mb-6 flex flex-col sm:flex-row">
        <Image
            src={frontmatter.imageCover}
            alt={`Book Cover For: ${frontmatter.title}`}
            class="mx-auto min-w-40 w-40 min-h-52 h-52 border-2 border-default-edge"
            width={450}
            height={600}
        />
        <div class="px-0 sm:px-4 pt-4 sm:py-2">
            <div
                class="mb-4 typography-common font-mono text-body-muted text-sm flex flex-col sm:flex-row gap-4 sm:gap-8">
                <div>
                    <p class="font-medium text-primary">PUBLISHED</p>
                    <p class="text-body">
                        <time datetime={frontmatter.datePublished} class="">{datePublished}</time>
                    </p>
                </div>
                <div>
                    <p class="font-medium text-primary">AUTHORS</p>
                    <span class="text-body">{authorsString}</span>
                </div>
            </div>

            <figcaption
                class="pt-2 text-body-muted font-mono typography-common text-sm">
                {frontmatter.description}
            </figcaption>
        </div>
    </figure>
</div>
