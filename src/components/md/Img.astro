---
import Image from "astro/components/Image.astro";

interface Props {
    path: ImageMetadata;
    caption: string;
    alt: string
}

const { path, alt, caption, width = 1200, height = 900} = Astro.props;

---
<!-- should be replaced with markdown directives -->
<figure class="px-0 mb-5">
    <Image
        src={path} 
        alt={alt}
        class="mx-auto w-full h-auto border-2 border-default-edge"
        height={height}
        width={width}
    />
    {
        caption && (
            <figcaption 
                class="pt-1 text-body-muted font-mono text-xs typography-common">
                [&uarr;] {caption}
            </figcaption>
        )
    }
</figure>