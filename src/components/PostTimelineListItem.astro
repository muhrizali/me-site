---
import { DateTime } from 'luxon';
import { getPostURL } from '../scripts/utils';

interface Props {
    postItem: any;
}

const { postItem } = Astro.props;

const postURL = getPostURL(postItem);
const datePublished = DateTime.fromISO(postItem.data.datePublished).toFormat("yyyy-LL-dd");
---
<tr>
    <th scope="row" class="pr-2 py-0 w-1 font-normal text-body-muted whitespace-nowrap border-r-2 border-default-edge">
        {datePublished}
    </th>
    <td class="px-2 py-0 font-bold whitespace-nowrap">
        <a
            href={postURL} 
            class="inline text-primary decoration-2 hover:underline active:underline">
            {postItem.data.title}
        </a>
    </td>
</tr>
