---

interface Props {
    routeURL: string;
}

const { routeURL } = Astro.props;

---
<button
    hx-get={routeURL}
    hx-trigger="click"
    hx-target="this"
    hx-swap="outerHTML"
    class="py-2 px-4 mt-10 block mx-auto w-full sm:w-48 cursor-pointer text-base/tight tracking-tight font-mono font-medium text-body-subtle hover:text-body active:text-body bg-neutral-primary hover:bg-neutral-secondary border-2 border-default active:border-brand">
    LOAD MORE
</button>
