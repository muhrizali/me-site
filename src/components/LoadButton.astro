---

interface Props {
    routeURL: string;
}

const { routeURL } = Astro.props;

---
<button
    hx-get={routeURL}
    hx-trigger="click"
    hx-preload="mouseover"
    hx-target="this"
    hx-swap="outerHTML"
    class="py-2 px-4 mt-10 block mx-auto w-full sm:w-48 cursor-pointer text-base/tight tracking-tight font-mono font-medium text-body-muted hover:text-body active:text-body bg-surface hover:bg-surface-secondary border-2 border-default-edge active:border-primary">
    LOAD MORE
</button>
