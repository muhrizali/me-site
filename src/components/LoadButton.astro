---

interface Props {
    routeURL: string;
}

const { routeURL } = Astro.props;

---
<button
    hx-get={routeURL}
    hx-trigger="click"
    hx-preload="mouseover"
    hx-target="this"
    hx-swap="outerHTML"
    class="py-2 px-4 mt-4 block mx-auto w-full sm:w-48 cursor-pointer text-sm/tight tracking-tight font-mono font-medium text-body hover:text-body active:text-body bg-surface hover:bg-surface-secondary border-2 border-default-edge active:border-primary">
    <span class="inline-block px-1.5 mr-2 rounded-full bg-primary text-surface font-bold">&darr;</span>
    LOAD MORE
</button>
