---
import Image from "astro/components/Image.astro";

const { postEntry } = Astro.props;
---

<Image
    src={postEntry.data.image}
    alt={postEntry.data.imageCaption ?? "image cover for the book"}
    width={600}
    height={1200}
    class="border-2 border-default group-active:border-brand group-hover:border-brand flex-none h-28 w-20"
/>
