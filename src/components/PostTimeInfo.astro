---
import { DateTime } from 'luxon';
interface Props {
    frontmatter: any;
}

const { frontmatter } = Astro.props;

// const datePublished = DateTime.fromISO(frontmatter.datePublished).toLocaleString(DateTime.DATE_MED);
const datePublished = DateTime.fromISO(frontmatter.datePublished).toFormat("LLL dd yyyy");
const dateModified = DateTime.fromISO(frontmatter.dateModified).toFormat("LLL dd yyyy");

---
<section class="mt-10 typography-common text-body-muted font-mono text-sm font-medium">
    <p>
        <time datetime={frontmatter.datePublished} class="">/ {datePublished}</time> <br />
        <time datetime={frontmatter.datePublished} class="">/ Last Updated: {dateModified}</time>
    </p>
    <!-- <span class="text-body-muted">
        by
        <span class="text-body">
            <a href="/about"> Muhriz Ali</a>
        </span> 
    </span> -->
    <!-- <span class="mx-2">&bull;</span> -->
        
</section>