---
import { DateTime } from 'luxon';
interface Props {
    frontmatter: any;
}

const { frontmatter } = Astro.props;

// const datePublished = DateTime.fromISO(frontmatter.datePublished).toLocaleString(DateTime.DATE_MED);
const datePublished = DateTime.fromISO(frontmatter.datePublished).toFormat("LLL dd yyyy");
// const dateModified = DateTime.fromISO(frontmatter.dateModified).toLocaleString(DateTime.DATE_MED);

---
<section class="mt-1 typography-common text-xs text-body-muted font-mono font-medium uppercase">
    <time datetime={frontmatter.datePublished} class="">{datePublished}</time> 
    <span class="mx-2 text-primary">&bull;</span>
    <span class="text-body">
        <a href="/about">Muhriz Ali</a></span> 
    <!-- <span class="mx-2">&bull;</span> -->
        
</section>