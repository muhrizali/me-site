---
const navigationItems = [
    {
        label: "Home",
        href: "/",
        icon: "🏠",
    },
    {
        label: "Blog",
        href: "/blog",
        icon: "📝",
    },
    {
        label: "Books",
        href: "/books",
        icon: "📚",
    },
    {
        label: "Work",
        href: "/work",
        icon: "🛠️",
    },
    {
        label: "About",
        href: "/about",
        icon: "😗",
    },
    // {
    //     label: "Now",
    //     href: "/now",
    //     icon: "⏳",
    // },
    // {
    //     label: "Archive",
    //     href: "/map",
    //     icon: "🗂️",
    // },

];
---

<nav class="bg-neutral-primary w-full mb-4">
    <div
        class="w-full mx-auto">
        <ul
            class="w-full bg-neutral-primary-subtle py-2 font-semibold font-mono text-base md:text-lg flex flex-row justify-center items-center gap-4 sm:gap-6 border-y-2 border-default overflow-x-scroll scrollbar-none uppercase">
            {
                navigationItems.map((item) => (
                    <li class="">
                        <a 
                            href={item.href} 
                            class="block text-body">
                            {/* <span 
                                class="block sm:hidden p-1 hover:bg-neutral-secondary active:bg-neutral-secondary border-2 border-transparent rounded-sm hover:border-brand active:border-brand">
                                {item.icon}
                            </span> */}
                            <span 
                                class="decoration-2 hover:decoration-brand active:decoration-brand hover:underline active:underline">
                                {item.label}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>
