---
const navigationItems = [
    {
        label: "Home",
        href: "/",
        icon: "🏠",
    },
    {
        label: "Posts",
        href: "/posts",
        icon: "📝",
        // icon: "🗃️",
    },
    {
        label: "Now",
        href: "/now",
        icon: "⏳",
    },
    {
        label: "About",
        href: "/about",
        icon: "😗",
    },
];
---

<nav class="bg-neutral-primary w-full z-20 top-0 inset-s-0">
    <div
        class="max-w-3xl mx-auto p-4 flex flex-wrap items-center justify-start">
        <ul
            class="w-full mt-4 font-semibold font-mono text-2xl sm:text-xl flex flex-row gap-4 sm:gap-6">
            {
                navigationItems.map((item) => (
                    <li>
                        <a 
                            href={item.href} 
                            class="block text-heading">
                            <span 
                                class="block sm:hidden p-1 hover:bg-neutral-secondary active:bg-neutral-secondary border-2 border-transparent rounded-sm hover:border-brand active:border-brand">
                                {item.icon}
                            </span>
                            <span 
                                class="hidden sm:inline decoration-2 hover:decoration-brand active:decoration-brand hover:underline active:underline">
                                {item.label}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>
