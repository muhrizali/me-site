---
const navigationItems = [
    {
        label: "Home",
        href: "/",
        icon: "🏠",
    },
    {
        label: "Blog",
        href: "/blog",
        icon: "📝",
    },
    {
        label: "Books",
        href: "/books",
        icon: "📚",
    },
    {
        label: "Work",
        href: "/work",
        icon: "🛠️",
    },
    {
        label: "About",
        href: "/about",
        icon: "😗",
    },
    // {
    //     label: "Now",
    //     href: "/now",
    //     icon: "⏳",
    // },
    // {
    //     label: "Archive",
    //     href: "/map",
    //     icon: "🗂️",
    // },

];
---

<nav class="bg-neutral-primary w-full py-4">
    <div
        class="w-full mx-auto flex flex-wrap items-center justify-start">
        <ul
            class="w-full bg-neutral-primary-subtle py-1 font-semibold font-mono text-2xl sm:text-xl flex flex-row gap-4 sm:gap-6 border-y-2 border-default justify-center overflow-x-scroll scrollbar-none uppercase">
            {
                navigationItems.map((item) => (
                    <li class="">
                        <a 
                            href={item.href} 
                            class="block text-heading">
                            <span 
                                class="block sm:hidden p-1 hover:bg-neutral-secondary active:bg-neutral-secondary border-2 border-transparent rounded-sm hover:border-brand active:border-brand">
                                {item.icon}
                            </span>
                            <span 
                                class="hidden sm:inline decoration-2 hover:decoration-brand active:decoration-brand hover:underline active:underline">
                                {item.label}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>
