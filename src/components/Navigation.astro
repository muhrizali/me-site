---
const navigationItems = [
    {
        label: "Home",
        href: "/",
        icon: "🏠",
    },
    {
        label: "Blog",
        href: "/blog",
        icon: "🧠",
    },
    {
        label: "Books",
        href: "/books",
        icon: "📚",
    },
    {
        label: "Projects",
        href: "/projects",
        icon: "🛠️",
    },
    {
        label: "Notes",
        href: "/notes",
        icon: "📒",
    },
    // {
    //     label: "About",
    //     href: "/about",
    //     icon: "😗",
    // },
    // {
    //     label: "Now",
    //     href: "/now",
    //     icon: "⏳",
    // },
    // {
    //     label: "Archive",
    //     href: "/map",
    //     icon: "🗂️",
    // },

];
---

<nav class="relative flex flex-col justify-center items-center w-full mb-4 bg-surface-soft border-y-2 border-default-edge">
    <div
        class="max-w-3xl px-4 mx-auto">
        <ul
            class="px-0 py-3 w-full flex flex-row gap-4 text-body text-lg/tight tracking-tight md:text-xl/tight font-bold font-mono uppercase overflow-x-auto scrollbar-thumb-default-edge scrollbar-thin">
            {
                navigationItems.map((item) => (
                    <li class="block shrink-0">
                        <a 
                            href={item.href}>
                            <span class="rounded-sm p-1 text-2xl inline sm:hidden border-2 border-transparent active:border-primary hover:border-primary active:active:bg-body/10 hover:active:bg-body/10">
                                {item.icon}
                            </span>
                            <span 
                                class="ui hidden sm:inline decoration-2 hover:decoration-primary active:decoration-primary hover:underline active:underline">
                                {item.label}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>
