---
const navigationItems = [
    {
        label: "Home",
        href: "/",
        icon: "🏠",
    },
    {
        label: "Blog",
        href: "/blog",
        icon: "📝",
    },
    {
        label: "Books",
        href: "/books",
        icon: "📚",
    },
    {
        label: "Projects",
        href: "/projects",
        icon: "🛠️",
    },
    {
        label: "Notes",
        href: "/notes",
        icon: "🛠️",
    },
    {
        label: "About",
        href: "/about",
        icon: "😗",
    },
    // {
    //     label: "Now",
    //     href: "/now",
    //     icon: "⏳",
    // },
    // {
    //     label: "Archive",
    //     href: "/map",
    //     icon: "🗂️",
    // },

];
---

<nav class="relative flex flex-col justify-center items-center w-full mb-4 bg-surface-soft border-y-2 border-default-edge">
    <!-- <div class="max-w-3xl border px-4 peer">
    </div> -->
    <div
        class="max-w-3xl px-4 mx-auto w-full sm:w-auto">
        <!-- <div class="text-body-muted my-auto px-1 font-bold text-lg sm:hidden">
            «
        </div> -->
        <ul
            class="px-0 py-2 w-full flex flex-row gap-4 text-body text-lg/tight tracking-tight md:text-xl/tight font-bold font-mono uppercase overflow-x-auto scrollbar-thumb-default-edge scrollbar-thin">
            {
                navigationItems.map((item) => (
                    <li class="block shrink-0">
                        <a 
                            href={item.href} 
                            class="">
                            <span 
                                class="decoration-2 hover:decoration-primary active:decoration-primary hover:underline active:underline">
                                {item.label}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>
