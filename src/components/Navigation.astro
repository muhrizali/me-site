---

<nav
    class="bg-neutral-primary w-full z-20 top-0 inset-s-0 border-b-0 border-default">
    <div
        class="max-w-5xl flex flex-wrap items-center justify-start mx-auto px-4 py-4 lg:px-0">

        <!-- <a href="/" class="block h-full p-1 border-2 border-default">
            <span
                class="text-2xl text-heading font-semibold whitespace-nowrap"
                >stupidali</span
            >
        </a> -->
        <button
            data-collapse-toggle="navbar-default"
            type="button"
            class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-body rounded-base md:hidden hover:bg-neutral-secondary hover:text-heading border-2 border-default"
            aria-controls="navbar-default"
            aria-expanded="false">
            <span class="sr-only">Open Navigation</span>
            <svg
                class="w-6 h-6"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24">
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="2"
                    d="M5 7h14M5 12h14M5 17h14"></path>
            </svg>
        </button>
        <div class="hidden w-full md:block md:w-auto" id="navbar-default">
            <ul
                class="font-medium flex flex-col p-4 md:p-0 mt-4 border-2 border-default rounded-base bg-neutral-secondary md:flex-row md:space-x-8 rtl:space-x-reverse md:mt-0 md:border-0 md:bg-neutral-primary">
                {
                    navigationItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class="block py-2 px-3 text-heading decoration-2 decoration-brand hover: hover:bg-neutral-tertiary hover:underline md:hover:bg-transparent md:border-0  md:p-0 md:dark:hover:bg-transparent"
                                aria-current="page">
                                {item.label}
                            </a>
                        </li>
                    ))}
            </ul>
        </div>
    </div>
</nav>
