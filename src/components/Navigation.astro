---
const navigationItems = [
    {
        label: "Home",
        href: "/",
        icon: "🏠",
    },
    {
        label: "Blog",
        href: "/blog",
        icon: "📝",
    },
    {
        label: "Books",
        href: "/books",
        icon: "📚",
    },
    {
        label: "Work",
        href: "/work",
        icon: "🛠️",
    },
    {
        label: "About",
        href: "/about",
        icon: "😗",
    },
    // {
    //     label: "Now",
    //     href: "/now",
    //     icon: "⏳",
    // },
    // {
    //     label: "Archive",
    //     href: "/map",
    //     icon: "🗂️",
    // },

];
---

<nav class="w-full mb-4 bg-neutral-primary-subtle border-y-2 border-default ">
    <div
        class="max-w-3xl px-4 w-fit mx-auto">
        <ul
            class="px-0 py-2 flex flex-row gap-4 overflow-x-auto scrollbar-none text-body text-lg md:text-xl font-medium font-mono uppercase">
            {
                navigationItems.map((item) => (
                    <li class="block w-fit shrink-0">
                        <a 
                            href={item.href} 
                            class="">
                            <span 
                                class="decoration-2 hover:decoration-brand active:decoration-brand hover:underline active:underline">
                                {item.label}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>
