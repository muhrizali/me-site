---
import Image from "astro/components/Image.astro";

interface Props {
    path: ImageMetadata;
    caption: string;    
}

const { path, caption = "" } = Astro.props;

---
<!-- should be replaced with markdown directives -->
<figure class="px-0 mb-5">
    <Image 
        src={path} 
        alt={caption}
        class="mx-auto w-full border-2 border-default"
        height={900}
        width={1200}
    />
    <figcaption class="pt-1 font-mono text-body-subtle text-xs/tight tracking-tight hyphens-auto">
        <slot />
    </figcaption>
</figure>