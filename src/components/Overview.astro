---
import PostOverviewList from "./PostOverviewList.astro";
---
<div class="grid md:grid-cols-2 gap-2 my-4">
    <article class="p-2">
        <h3 class="text-xl/tight text-heading font-bold">BLOGS</h3>
        <PostOverviewList target="blogPosts" count={3} />
    </article>
    <article class="p-2">
        <h3 class="text-xl/tight text-heading font-bold">BOOKS</h3>
        <PostOverviewList target="bookPosts" count={3} />
    </article>
    <article class="p-2">
        <h3 class="text-xl/tight text-heading font-bold">NOTES</h3>
        <PostOverviewList target="notePosts" count={3} />
    </article>
    <article class="p-2">
        <h3 class="text-xl/tight text-heading font-bold">PROJECTS</h3>
        <PostOverviewList target="projectPosts" count={3} />
    </article>
</div>