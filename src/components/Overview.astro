---
import PostOverviewList from "./PostOverviewList.astro";
import { getAllPostCategories } from "../scripts/utils";

const allCategories = await getAllPostCategories();

---
<div class="grid md:grid-cols-2 gap-2">
    {
        allCategories.map(
            (category: string) => (
                <section class="p-2">
                    <h3 class="text-xl/tight text-heading font-bold">
                        <a href={`/category/${category}`} class="decoration-2 decoration-brand hover:underline active:underline">{category}</a>
                    </h3>
                    <PostOverviewList category={category} count={3} />
                </section>
            )
        )
    }
</div>