---
import { DateTime } from 'luxon';
import PostListItemSection from './PostListItemSection.astro';
import PostListItemBlogImage from './PostListItemBlogImage.astro';
import PostListItemBookImage from './PostListItemBookImage.astro';
import PostListItemProjectImage from './PostListItemProjectImage.astro';
import PostListItemNoteImage from './PostListItemNoteImage.astro';
import { CONFIG, ContentCollection, getPostRoute, getPostURL } from "../scripts/utils";


interface Props {
    postEntry: any;
}

const { postEntry } = Astro.props;

// const postDatePublished = DateTime.fromISO(postEntry.data.datePublished).toLocaleString(DateTime.DATETIME_MED);

// const route: string = getPostRoute(postEntry.data.category);
const postURL: string = getPostURL(postEntry);

---

<li class="group">
    <a 
        href={postURL}
        class="flex flex-row gap-2">
        { (postEntry.data.category === "BLOGS") && <PostListItemBlogImage postEntry={postEntry} /> }
        { (postEntry.data.category === "BOOKS") && <PostListItemBookImage postEntry={postEntry} /> }
        { (postEntry.data.category === "PROJECTS") && <PostListItemProjectImage postEntry={postEntry} /> }
        { (postEntry.data.category === "NOTES") && <PostListItemNoteImage postEntry={postEntry} /> }
        <PostListItemSection postEntry={postEntry} />
    </a>
</li>
