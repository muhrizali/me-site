---
import Layout from "./Layout.astro";
import { Metadata } from "../scripts/types";

// MARKDOWN WEB LAYOUT
// Used for any page created with markdown
// but can contain interactive elements

// Used for markdown pages which are not articles
// and not just contains markdown

interface Props {
    frontmatter: any;
}

let { frontmatter } = Astro.props;
const metadata: Metadata = { 
    title: frontmatter.title, 
    description: frontmatter.description 
};

---
<Layout metadata={metadata}>
    <slot />
</Layout>
