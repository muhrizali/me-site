---
import Layout from "./Layout.astro";
import Writing from "../components/Writing.astro";
import PostFront from "../components/PostFront.astro";
import { Metadata } from "../scripts/types";
import PostDemographItem from "../components/PostDemographItem.astro";

// MARKDOWN ARTICLE LAYOUT
// Used for any article created with markdown
// which is part of any content collections

interface Props {
    frontmatter: any;
    headings: any[];
}

const { frontmatter, headings } = Astro.props;
const metadata: Metadata = {
    title: frontmatter.title,
    description: frontmatter.description
}

---
<Layout metadata={metadata}>
    <PostFront frontmatter={frontmatter} headings={headings} />
    <Writing>
        <slot />
    </Writing>

    <PostDemographItem frontmatter={frontmatter} />
</Layout>
